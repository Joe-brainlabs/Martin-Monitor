# Copy to .env and fill in. .env is gitignored; these names are what the code reads.
# In production (Railway) paste the same names into the service's Variables tab.

# Where the SQLite file lives. Local default is ./data; on Railway use the mounted volume: /data
DATA_DIR=
# Optional. When set, POST /api/run/<source> with header X-Admin-Token triggers a poll now. Unset = endpoint off.
ADMIN_TOKEN=

# X (already have)
CONSUMER_KEY=
SECRET_KEY=
BEARER_TOKEN=

# Brian (platform.claude.com -> API keys; set a monthly spend limit in the console)
ANTHROPIC_API_KEY=

# Instagram (ensembledata.com free trial token)
ENSEMBLE_TOKEN=

# YouTube (Google Cloud API key with YouTube Data API v3 enabled).
# Ours is from the "Anomaly Checker" project in Joe's Google Cloud console.
YOUTUBE_API_KEY=

# Reddit (reddit.com/prefs/apps -> create app, type "script")
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=martin-monitor/0.1 by <your reddit username>

# Google Trends via Decodo's Web Scraping API (decodo.com). Chosen over SerpApi on 30 Sep 2026.
# Worldwide series by decision: Decodo rejects geo on the trends target.
# Scraper user credentials from the Web Scraping API tab; the code sends them as HTTP Basic auth.
DECODO_USERNAME=
DECODO_PASSWORD=
