{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "martin-monitor",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "SCHEDULER=0 .venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8765"
      ],
      "port": 8765
    },
    {
      "name": "martin-monitor-dev",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "SCHEDULER=0 ADMIN_TOKEN=${ADMIN_TOKEN:-dev} .venv/bin/uvicorn app.main:app --host 127.0.0.1 --port ${PORT:-8767}"
      ],
      "port": 8767,
      "autoPort": true
    }
  ]
}
